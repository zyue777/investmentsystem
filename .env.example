# 投资系统环境变量模板
# 复制为 .env 后填入真实 Key：cp .env.example .env

# ── 飞书应用 ──
FEISHU_INVEST_APP_ID=cli_xxx          # 投研Bot（群1）
FEISHU_INVEST_APP_SECRET=xxx
FEISHU_DS_APP_ID=cli_xxx              # 投研Bot(DS)（群2）
FEISHU_DS_APP_SECRET=xxx

# ── Bot 开关 ──
ENABLE_INVEST_BOT=true                # 群1 investment
ENABLE_CLAUDE_BOT=true                # 向后兼容别名，与 ENABLE_INVEST_BOT 同值

# ── Invest Bot AI（群1 · 中转站 · litellm）──
AI_MODEL_INVEST=openai/claude-sonnet-4-6
AI_API_BASE_INVEST=https://api.chr1.com/v1
AI_API_KEY_INVEST=sk-你的中转站key

# ── DS Bot AI（群2 · 直连 · litellm）──
AI_MODEL_DS=openai/deepseek-v4-pro
AI_API_BASE_DS=https://api.deepseek.com/v1
AI_API_KEY_DS=sk-你的deepseekkey

# ── 向后兼容 fallback（单 Bot 或未配 _DS/_INVEST 前缀时使用）──
# AI_MODEL=openai/deepseek-v4-pro
# AI_API_BASE=https://api.deepseek.com/v1
# AI_API_KEY=sk-xxx

# ── 废弃（保留注释，勿再使用）──
# CLAUDE_RELAY_URL=https://xxxx.trycloudflare.com
# CLAUDE_RELAY_SECRET=invest-relay-2026

# ── 系统 ──
LOG_LEVEL=INFO
