# pyenv
.python-version

# pipenv
#   According to pypa/pipenv#1173, pipenv should detach itself from pyenv.
#   In that case, the python-version file should still be ignored.
#   If you are using pipenv, then you should ignore the virtualenv.
# .venv
# bin/
# Pipfile.lock

# poetry
#   Similar to pipenv, poetry should detach itself from pyenv.
#   In that case, the python-version file should still be ignored.
#   If you are using poetry, then you should ignore the virtualenv.
# .venv
# poetry.lock

# pdm
#   Similar to pipenv, pdm should detach itself from pyenv.
#   In that case, the python-version file should still be ignored.
#   If you are using pdm, then you should ignore the virtualenv.
# .pdm.toml
# .pdm-python
# .pdm-build/

# PEP 582; used by e.g. github.com/ptmcg/pdm and github.com/sdispater/poetry
__pypackages__/

